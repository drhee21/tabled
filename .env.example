# Copy to .env.local and fill in. Server-side only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Places API (New). Server-side only, used by lib/places/google-provider.ts.
# In Google Cloud, enable "Places API (New)", restrict this key to that API only,
# and set a budget alert and a daily quota cap. Searches bill at the Nearby Search
# Enterprise SKU (1,000 free calls a month, then about $35 per 1,000).
GOOGLE_PLACES_API_KEY=

# Public by design (sent to the browser). Used only so the host's page can
# listen for live "who has submitted" events. Leave blank to disable live
# updates; the page still works with the Refresh button.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Language model that ranks the shortlist. Server-side only, used by
# lib/llm/anthropic-client.ts (Anthropic API). Set a spend limit on the key in
# the Anthropic Console. Each search makes one request, or two if the first
# answer fails validation.
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
