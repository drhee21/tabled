# Copy to .env.local and fill in. Server-side only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public by design (sent to the browser). Used only so the host's page can
# listen for live "who has submitted" events. Leave blank to disable live
# updates; the page still works with the Refresh button.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
